{
    "google-translate.firstLanguage": "ru",
    "cSpell.language": "en,ru",
    "editor.renderWhitespace": "none",
    "workbench.colorTheme": "WebStorm Darcula Darker Theme V2",
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "variable.parameter",
                "settings": {
                    "fontStyle": "italic underline",
                    "foreground": "#e0e0e0"
                }
            }
        ]
    },
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "type": {
                "foreground": "#108478",
                "fontStyle": "italic underline"
            },
            "interface": {
                "foreground": "#108478",
                "fontStyle": "italic underline"
            }
        }
    },
    "hediet.vscode-drawio.resizeImages": null,
    "typescript.experimental.useTsgo": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${basename}.js"
    },
    "audioCues.enabled": "off",
    "editor.accessibilitySupport": "off",
    "totalTypeScript.hideAllTips": false,
    "totalTypeScript.hideBasicTips": false,
    "commentTranslate.targetLanguage": "ru",
    "commentTranslate.sourceLanguage": "auto",
    "commentTranslate.engines": [
        "google"
    ],
    "accessibility.signals.terminalBell": {
        "sound": "off"
    },
    "terminal.integrated.enableVisualBell": false,
    "[typescript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "editor.fontSize": 12,
    "editor.formatOnSave": true,
    "editor.mouseWheelZoom": true,
    "[json]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint",
        "editor.formatOnSave": false
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "files.exclude": {
        "**/.git": false
    },
    "git.autofetch": true,
    "eslint.format.enable": true,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "eslint.useFlatConfig": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "explicit"
    },
    "eslint.validate": [
        "typescript"
    ],
    "eslint.workingDirectories": [],
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "editor.defaultFoldingRangeProvider": "dbaeumer.vscode-eslint",
    "[snippets]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "npm.enableRunFromFolder": true,
    "npm.scriptExplorerAction": "run"
}